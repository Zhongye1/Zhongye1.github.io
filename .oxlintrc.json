{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "import", "typescript", "unicorn", "oxc", "vue"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "rules": {
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }]
  },
  "ignorePatterns": [
    ".nuxt/**",
    ".output/**",
    ".nitro/**",
    ".data/**",
    ".cache/**",
    "dist/**",
    "node_modules/**",
    "public/**",
    "worker-twikoo/src/twikoo/**"
  ]
}
