{
  "compilerOptions": {
    "target": "ES2022",
    // 不引 DOM：Worker 里没有 DOM，引进来只会让 document/window 这类误用通过类型检查
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // vendor 进来的适配器是 JS：allowJs 让它参与解析，checkJs 不开——产物不需要我们重查一遍
    "allowJs": true
  },
  "include": ["src/**/*.ts", "src/**/*.js"]
}
