{
  "name": "nuxt-app",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@iconify-json/icon-park-outline": "^1.2.4",
    "@shikijs/colorized-brackets": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "@unocss/reset": "^66.10.5",
    "better-sqlite3": "^13.0.3",
    "consola": "^3.4.2",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/catppuccin": "^1.2.17",
    "@iconify-json/tabler": "^1.2.39",
    "@nuxt/content": "^3.16.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^22",
    "@unocss/nuxt": "^66.10.5",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "lint-staged": "^13.2.1",
    "minimark": "0.2.0",
    "nuxt": "^4.5.2",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.8",
    "sass": "^1.104.1",
    "simple-git-hooks": "^2.8.1",
    "typescript": "^5.9.3",
    "unist-util-visit": "5.1.0",
    "unocss-preset-chinese": "^0.3.3",
    "vfile": "6.0.3",
    "vue-tsc": "^3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "oxlint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "pnpm": {
    "patchedDependencies": {
      "@nuxtjs/mdc@0.23.1": "patches/@nuxtjs__mdc@0.23.1.patch"
    }
  }
}
